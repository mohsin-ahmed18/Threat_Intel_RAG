# Copy this file to .env and fill in your own values. .env is gitignored.

# Optional — raises NVD rate limit from 5 to 50 req/30s
# Get one free at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Qdrant connection (defaults work for local docker-run Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# LLM provider for generation
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
